# Copy this file to .env and load it in the shell before using LLM mode.
# Never commit a real .env file or API key.

# OpenAI (required for --provider openai)
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-a-chat-model
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (no API key required for the default local server)
OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434/v1
