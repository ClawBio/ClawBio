flowchart TD
    Q["variant: rsID or chr_pos_ref_alt"] --> R["resolve on GRCh38<br/>Open Targets variant search<br/>effect allele = Open Targets alt"]
    R --> M["place on GRCh37<br/>Ensembl assembly mapper"]
    R --> FG_API["FinnGen web API<br/>one request, values only p &lt; 0.05"]
    FG_API -->|censored endpoints, or API down| FG_TBX["FinnGen R12 endpoint files<br/>index walker, one position"]
    M --> PAN["Pan-UK Biobank outcome files<br/>index walker, one position<br/>default: 589 outcomes with a FinnGen counterpart<br/>--all-outcomes: 7,160"]
    FG_API --> O
    FG_TBX --> O
    PAN --> O["orient on the effect allele<br/>swap = re-sign; palindromic swap = withhold"]
    O --> P{"rows == catalog as sets?"}
    P -->|no| X["fail loudly"]
    P -->|yes| H["outcome crosswalk<br/>ICD10 block / FinnGen published match"]
    H --> V["replication verdicts<br/>p &lt; 0.05 / outcomes both catalogs share"]
    V --> OUT["report.md, result.json<br/>tables/, figures/, reproducibility/"]
    CAT[("outcome catalogs<br/>+ crosswalk")] -.-> P
    CAT -.-> H
